// ==========================================================
// Question 1: Indexed Array
// ==========================================================
$technologies = array("AI", "Cloud Computing", "Cyber Security", "IoT");
echo "<h3>Indexed Array:</h3>";
foreach ($technologies as $technology) {
    echo $technology . "<br>";
}


// ==========================================================
// Question 2: Associative Array
// ==========================================================
$details = array(
    "name" => "Artificial Intelligence",
    "category" => "Software",
    "year" => 1956
);

echo "<h3>Associative Array:</h3>";
foreach ($details as $key => $value) {
    echo ucfirst($key) . ": " . $value . "<br>";
}


// ==========================================================
// Question 3: Write to a File
// ==========================================================
file_put_contents("technologies.txt", "Artificial Intelligence\nCloud Computing\n", FILE_APPEND | LOCK_EX);
echo "<p>Data successfully written to technologies.txt</p>";


// ==========================================================
// Question 4: Read from a File
// ==========================================================
echo "<h3>Read from File:</h3>";
if (file_exists("technologies.txt")) {
    echo nl2br(htmlspecialchars(file_get_contents("technologies.txt")));
} else {
    echo "File not found.";
}
?>

