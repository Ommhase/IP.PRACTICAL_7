<?php
$technologies = array(
    array("name" => "Artificial Intelligence", "category" => "Software"),
    array("name" => "Cloud Computing", "category" => "Infrastructure"),
    array("name" => "Cyber Security", "category" => "Security"),
    array("name" => "Internet of Things", "category" => "Networking")
);

$file = "technologies.txt";

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $newTechnology = trim($_POST['technology'] ?? '');
    if ($newTechnology !== '') {
        file_put_contents($file, $newTechnology . PHP_EOL, FILE_APPEND | LOCK_EX);
    }
}
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>PHP Arrays and Files</title>
</head>
<body>
    <h1>Technology List (Indexed and Associative Arrays)</h1>
    <ul>
        <?php foreach ($technologies as $item): ?>
            <li>
                <strong><?php echo htmlspecialchars($item['name']); ?></strong> - 
                (<?php echo htmlspecialchars($item['category']); ?>)
            </li>
        <?php endforeach; ?>
    </ul>

    <h2>Write to File</h2>
    <form method="post" action="">
        <label>Technology name: <input type="text" name="technology" required></label>
        <button type="submit">Save</button>
    </form>

    <h2>Read from technologies.txt</h2>
    <?php if (file_exists($file)): ?>
        <pre><?php echo htmlspecialchars(file_get_contents($file)); ?></pre>
    <?php else: ?>
        <p>No file created yet. Submit a technology above to create it.</p>
    <?php endif; ?>
</body>
</html>
